# Firebase web config is PUBLIC by design — `apiKey` is a quota identifier, not
# an authorization credential. It was already served inline in every HTML
# response before this was a static bundle. Security is enforced server-side by
# Admin SDK ID-token verification, so committing this is safe and avoids
# plumbing non-secrets through CI.
VITE_FIREBASE_WEB_API_KEY=AIzaSyDnc8EstQh9p4CjF1K94ch_vsditwm0HYg
VITE_FIREBASE_WEB_AUTH_DOMAIN=auto-trader-493814.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=auto-trader-493814
VITE_PUBLIC_URL=https://bt-gateway-coolify.bogdanripa.com
